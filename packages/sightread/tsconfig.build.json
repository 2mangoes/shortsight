{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"types": ["bun", "node"]
	},
	"include": ["src"]
}
